    "cabinet.dialog.inbox_validate": "{ \"path\": \"RUNTIME 下 inbox md 绝对或相对路径\" }",
    "cabinet.dialog.inbox_list": "{ \"source\": \"\" }",
    "cabinet.dialog.inbox_merge_session": "{ \"session_id\": \"wecom:room\", \"source_prefix\": \"wecom_\" }",
    "cabinet.dialog.append_wecom_dedup": "{ \"msg_id\", \"source\", \"session_id\", \"role\", \"text\", ... }",
    "cabinet.enseal.materialize_draft": "{ \"draft_path\": \"...\" }",
    "cabinet.enseal.materialize_from_inbox": "{ 见 enseal_skill / cabinet_builtins 入参 }",
    "cabinet.enseal.materialize_from_cognitive_patch": "{ 见 enseal_skill --materialize-from-cognitive-patch }",
    "cabinet.enseal.seal_scan": "{ 见 enseal_skill seal_scan 参数 }",
    "cabinet.enseal.seal_batch": "{ 见 enseal_skill seal_batch 参数 }",
    "cabinet.metadata.extract_triple_a": "{ \"path\": \"...\" }",
    "cabinet.path_guardian.check_ssot": "{ \"path\": \"相对 SSOT 或绝对路径\", \"as_dir\": false }",
    "cabinet.psr.status": "{}"
